/reference/mmmsfall/

# Per-case copies are regenerated by scripts/prepare.py from the verified source.
/inputs/*/CuYM.eam.alloy

# Diagnostic/duplicate data; keep the complete authoritative results/cluster/ tree.
/results/first_pass/
/results/*.tar.gz
/results/*.tgz
/results/*.zip

# Older report drafts; keep the current Markdown, HTML and report images.
/report/archive/
/local_archive/

# Copies made for manual GUI importing and regenerated binary scene state files.
/ovito/*.lammpstrj
/ovito/states/

# Matplotlib/OVITO/Qt runtime output.
.matplotlib/
core
core.*
