# 3d Cu minimization MS at T = 0K

units		metal
boundary	p p p

atom_style	atomic

read_data	data.p111

pair_style	eam/alloy
pair_coeff	* * CuYM.eam.alloy Cu 

neighbor	0.3 bin
neigh_modify	delay 5

thermo		10
timestep	0.001

variable	pe equal pe
compute		pea all pe/atom

dump		2 all custom 1000 s1r*.xyz id type x y z c_pea
dump_modify	2 sort id

min_style	cg
#min_style	sd
minimize	1.0e-12 1.0e-12 5000 5000
undump		2
